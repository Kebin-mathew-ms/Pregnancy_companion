<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/frame_background"
        android:padding="13dp"
        android:layout_margin="2dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="5dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical">


            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="left"
                android:layout_gravity="left">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/baseline_person_pin_24"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tvuname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#3F60A0"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:text="Username"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#3F60A0"
                        android:text="Title"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>

            </TableRow>






            <!-- TextView for displaying text -->
            <TextView
                android:id="@+id/tvpost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#3F60A0"
                android:textSize="16sp" />



            <TextView
                android:id="@+id/tvdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#024305"
                android:text="Date"
                android:textStyle="bold"
                android:gravity="right"
                android:textSize="13sp" />



            <!-- ImageView for displaying images -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true" />

            <!-- VideoView for video playback -->
            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play and Pause Audio"
                android:padding="7dp"
                android:background="@drawable/modern_button_background"
                android:visibility="gone"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/vplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play"
                android:visibility="gone"
                android:background="@drawable/modern_button_background"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/playButton"
                android:visibility="gone"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"/>

            <TextView
                android:id="@+id/cmts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:gravity="right"
                android:textSize="15dp"
                android:textColor="#7E0303"
                android:textStyle="bold"
                android:text="Comments"/>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
