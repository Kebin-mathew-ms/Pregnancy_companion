<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bb"
    tools:context=".User_home">



    <ImageView
        android:id="@+id/imgvlogout"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/baseline_logout_24"
        android:layout_gravity="right"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/codystar_light"
        android:textFontWeight="900"
        android:textStyle="bold"
        android:textSize="30dp"
        android:text="Know It Right"
        android:textColor="#fff" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/imageViewPager"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginBottom="80dp"
        android:layout_gravity="center" />

<!--<ImageView-->
<!--    android:layout_width="140dp"-->
<!--    android:layout_height="140dp"-->
<!--    android:layout_marginTop="-40dp"-->
<!--    android:background="@drawable/prof1"-->
<!--    android:layout_gravity="center"/>-->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:layout_marginTop="-55dp"
        app:cardCornerRadius="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#90F8F6F6"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1" >

            <ImageButton
                android:id="@+id/upload_pdf"
                android:background="@drawable/res"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:textColor="#3F60A0"
                android:textStyle="bold"
                android:text="Resume"/>
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" /> <!-- Add a small space between the ImageButtons -->


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1" >
            <ImageButton
                android:id="@+id/upload_pdf2"
                android:background="@drawable/jc"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:textColor="#3F60A0"
                android:textStyle="bold"
                android:text="Jobs"/>
        </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" /> <!-- Add a small space between the ImageButtons -->


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1" >
                <ImageButton
                    android:id="@+id/upload_pdf3"
                    android:background="@drawable/cmp"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:textColor="#3F60A0"
                    android:textStyle="bold"
                    android:text="Company"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/frame_background"
        android:padding="10dp"
        android:layout_gravity="center">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/lvfeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/imfeed"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/dd"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textStyle="bold"
                    android:layout_marginTop="-18dp"
                    android:textColor="#3F60A0"
                    android:textSize="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lvapplication"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/imapp"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/apl"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applications"
                    android:textStyle="bold"
                    android:layout_marginTop="-18dp"
                    android:textColor="#3F60A0"
                    android:textSize="10dp"/>
            </LinearLayout>



            <LinearLayout
                android:id="@+id/lvdes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/imdes"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/intt"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Internship"
                    android:textStyle="bold"
                    android:layout_marginTop="-18dp"
                    android:textColor="#3F60A0"
                    android:textSize="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lvcom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/imcom"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/k4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complaints"
                    android:textStyle="bold"
                    android:layout_marginTop="-18dp"
                    android:paddingLeft="15dp"
                    android:textColor="#3F60A0"
                    android:textSize="10dp"/>
            </LinearLayout>

            <!-- Add more LinearLayouts as needed -->

        </TableRow>
    </LinearLayout>




</LinearLayout>
