<!-- custom_button_bg.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3F60A0" /> <!-- Green color when pressed -->
            <corners android:radius="20dp" /> <!-- Curved corners -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#3F60A0" /> <!-- Green border -->
            <corners android:radius="20dp" /> <!-- Curved corners -->
        </shape>
    </item>
</selector>
